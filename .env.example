# Environment settings for building this layer locally with kas-container.
# Nothing loads this file automatically: copy it to .env, adjust the values,
# and export them in the shell that runs kas-container:
#   set -a; . ./.env; set +a
# The values below are safe examples. All settings are optional.

# Path to the kas-container script. Read by ci/kas-container-shell-helper.sh.
# Type: file path. Unset: the helper uses the kas-container found on PATH.
KAS_CONTAINER=/usr/local/bin/kas-container

# Directory where kas clones the layers and writes build/. Keep it outside the
# checkout. Type: directory path. Unset: kas-container uses the current directory.
KAS_WORK_DIR=/srv/yocto/kas-work

# Shared download cache, passed into the build container.
# Type: directory path. Unset: BitBake uses build/downloads in the work directory.
DL_DIR=/srv/yocto/downloads

# Shared-state (sstate) cache, passed into the build container.
# Type: directory path. Unset: BitBake uses build/sstate-cache in the work directory.
SSTATE_DIR=/srv/yocto/sstate-cache
