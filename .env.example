# Environment settings for building the layer with kas-container.
# Copy this file to .env, adjust the values, and load it into the current shell
# before running kas-container or ci/kas-container-shell-helper.sh:
#   set -a; . ./.env; set +a
# Every setting is optional, and a value already set in the environment is kept.

# KAS_CONTAINER: path to the kas-container script. Optional string; when unset,
# ci/kas-container-shell-helper.sh uses the kas-container found on PATH.
KAS_CONTAINER=${KAS_CONTAINER:-$HOME/.local/bin/kas-container}

# KAS_WORK_DIR: directory where kas-container clones the other layers and runs
# the build (the build directory is $KAS_WORK_DIR/build). Optional existing
# directory; when unset, kas-container uses the current directory. Keep it
# outside the checkout.
KAS_WORK_DIR=${KAS_WORK_DIR:-$HOME/yocto/kas-work}

# DL_DIR: download cache shared between builds. Optional directory, created if
# missing; when unset, downloads go under the build directory.
DL_DIR=${DL_DIR:-$HOME/yocto/downloads}

# SSTATE_DIR: shared-state cache, which lets later builds reuse finished tasks.
# Optional directory, created if missing; when unset, it lives under the build
# directory.
SSTATE_DIR=${SSTATE_DIR:-$HOME/yocto/sstate-cache}
